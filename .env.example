# 模型 provider: openai | ollama | deepseek | minimax | mock
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=sk-xxxx
OPENAI_MODEL=gpt-4o-mini
# 分角色模型（可选）：主管用强模型，Worker 用轻量模型省成本；不配则都用 OPENAI_MODEL
SUPERVISOR_MODEL=
WORKER_MODEL=
EMBEDDING_MODEL=text-embedding-3-small

# Ollama（OpenAI 兼容端点）
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# DeepSeek（chat 用；官方无 embedding API，向量化默认走本地 Ollama）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# MiniMax（chat + embedding 一个 key 全搞定，推荐）
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-Text-01
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_EMBEDDING_MODEL=embo-01

# 独立 embedding 供应商（可选）：默认跟随 chat provider；deepseek 默认 ollama
EMBEDDING_PROVIDER=

# 网络搜索（可选）：配置后 web_searcher 使用 Tavily，否则回退 DuckDuckGo
TAVILY_API_KEY=

# 运行控制
# 最大轮次：简单问答 4 够用；复合题（多专家接力，如 E20-E22）建议 6
MAX_ITERATIONS=6


# ======================== 可观测性后端（OBSERVABILITY）========================
# 默认 memory：本进程内 dict 上限 50 条,不落盘,适合本地调试与简历 demo。
# 选 langsmith 时,需要同时配置下方 LANGSMITH_* ；未配置正确时实际行为等于
# memory（自动降级,业务不感知）。
#
# 在 LangSmith UI 上即可看到完整的 agent_run:<8位run_id> 根 trace,以及
# 每个 LangGraph 节点作为 child span。也可以继续用 http://localhost:8000
# 原本的"运行监测"页面（永远走本地双写）。
OBSERVABILITY_BACKEND=memory

# ---- LangSmith（仅当 OBSERVABILITY_BACKEND=langsmith 时生效）----
# 去 https://smith.langchain.com 注册免费账号,创建 API Key,并按提示设 Project。
# 注意：LangSmith SaaS 默认会上传 prompt/输出到 LangChain 托管云,
# 简历 demo 场景可以放心,因为没有真实业务流量；生产环境请评估合规。
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=agent-rag-supervisor